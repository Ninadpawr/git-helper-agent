# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional: free Postgres (Neon/Supabase) so history survives restarts.
# If empty, a local SQLite file is used (history resets on free hosts when they restart).
DATABASE_URL=

# Optional
GROQ_MODEL=llama-3.3-70b-versatile
